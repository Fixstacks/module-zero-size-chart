    Size charts: one table each, shown to the products of its categories.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="zero_size_chart" resource="default" engine="innodb" comment="Zero Size Chart">
        <column xsi:type="int" name="chart_id" unsigned="true" nullable="false" identity="true" comment="Chart ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name (admin)"/>
        <column xsi:type="varchar" name="heading" nullable="true" length="255" comment="Heading shown to the customer"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Active"/>
        <column xsi:type="text" name="table_json" nullable="false" comment="Columns and rows (JSON)"/>
        <column xsi:type="text" name="note" nullable="true" comment="Note under the table"/>
        <column xsi:type="text" name="category_ids" nullable="true" comment="Category IDs, comma separated"/>
        <column xsi:type="smallint" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="chart_id"/>
        </constraint>
        <index referenceId="ZERO_SIZE_CHART_IS_ACTIVE_SORT_ORDER" indexType="btree">
            <column name="is_active"/>
            <column name="sort_order"/>
        </index>
    </table>
</schema>
